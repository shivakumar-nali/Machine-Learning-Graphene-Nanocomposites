# FeAg3 Energy Minimization - Final

# Initialize
units metal
dimension 3
boundary p p p
atom_style atomic

# Read structure
read_data "/mnt/c/Users/danie/feag3_Mechanical_Properties/inputs/feag3_structure_corrected.lmp"

# Potential setup
pair_style lj/cut 5.0
pair_coeff 1 1 0.1 2.5    # Fe-Fe
pair_coeff 2 2 0.15 2.8   # Ag-Ag  
pair_coeff 1 2 0.125 2.65 # Fe-Ag

# Neighbor settings
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# Compute stress
compute peratom all stress/atom NULL
compute p all reduce sum c_peratom[1] c_peratom[2] c_peratom[3]

# Energy minimization
thermo 10
thermo_style custom step pe etotal press vol lx ly lz
min_style cg
minimize 1.0e-10 1.0e-10 1000 10000

# Write minimized structure
write_data "/mnt/c/Users/danie/feag3_Mechanical_Properties/outputs/feag3_minimized.lmp"

# Output final energy
variable final_pe equal pe
print "Final Potential Energy: ${final_pe} eV"
print "Minimization completed successfully!"
