# FeAg3 Energy Minimization

# Initialize
units metal
dimension 3
boundary p p p
atom_style atomic

# Read structure
read_data "..\..\inputs\feag3_structure.lmp"

# Potential setup
pair_style lj/cut 5.0
include "..\..\data\potentials\feag_potential.lmp"

# Neighbor settings
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# Energy minimization
thermo 10
thermo_style custom step pe press pxx pyy pzz lx ly lz
min_style cg
minimize 1.0e-10 1.0e-10 1000 10000

# Write minimized structure
write_data "..\..\outputs\feag3_minimized.lmp"

# Output final energy
variable final_pe equal pe
print "Final Potential Energy: \ eV"
