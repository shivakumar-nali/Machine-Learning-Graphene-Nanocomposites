# FeAg3 Uniaxial Tensile Test - Corrected

# Initialize
units metal
dimension 3
boundary p p p
atom_style atomic

# Read clean structure
read_data /mnt/c/Users/danie/feag3_Mechanical_Properties/inputs/feag3_clean.lmp

# Potential setup
pair_style lj/cut 5.0
pair_coeff * * 0.125 2.65

# Neighbor settings
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# Energy minimization first
min_style cg
minimize 1.0e-10 1.0e-10 1000 10000

# Compute stress and strain
compute stress all stress/atom NULL
variable strain_xx equal (lx/5.77704618-1.0)
variable stress_xx equal (-pxx/10000)

# Thermo settings for tensile test
thermo 100
thermo_style custom step v_strain_xx v_stress_xx pe press vol

# Temperature initialization
velocity all create 300.0 12345 dist gaussian
timestep 0.001

# NVT equilibration before tensile test
fix nvt all nvt temp 300 300 0.1
run 500
unfix nvt

# Tensile deformation in x-direction
fix deform all deform 1 x erate 0.0001 remap x

# Run tensile test
run 1000

# Write final structure
write_data /mnt/c/Users/danie/feag3_Mechanical_Properties/outputs/feag3_tensile_final.lmp

print "Tensile test completed!"
print "Final strain: ${v_strain_xx}"
print "Final stress: ${v_stress_xx} GPa"
